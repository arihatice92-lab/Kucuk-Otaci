  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroController
  introCamera: {fileID: 1441249106}
  subtitle: {fileID: 457080480}
  fade: {fileID: 1277828408}
  shots:
  - cameraStart: {fileID: 1296261105}
    cameraEnd: {fileID: 2059010032}
    duration: 6
    subtitle: "Lokmaneli, da\u011Flar\u0131n aras\u0131nda sakl\u0131 k\xFC\xE7\xFCk bir k\xF6yd\xFCr."
  - cameraStart: {fileID: 1420108629}
    cameraEnd: {fileID: 1328328731}
    duration: 6
    subtitle: "Her y\u0131l hasad\u0131n sonunda b\xFCt\xFCn k\xF6y Hasat \u015Eenli\u011Fi\u2019nde bir araya gelir."
  - cameraStart: {fileID: 1448882731}
    cameraEnd: {fileID: 735095900}
    duration: 6
    subtitle: "Ama bu y\u0131l ya\u011Fmurlar yolu y\u0131kt\u0131."
  - cameraStart: {fileID: 664240308}
    cameraEnd: {fileID: 341942539}
    duration: 6
    subtitle: "\u015Eenli\u011Fe yard\u0131m etmeye geldin. Yan\u0131nda sad\u0131k dostun F\u0131nd\u0131k var."
  - cameraStart: {fileID: 1248256738}
    cameraEnd: {fileID: 689224682}
    duration: 6
    subtitle: "Kap\u0131y\u0131 Basri Amca bekler. K\xF6ye yard\u0131m etmeyene kap\u0131y\u0131 a\xE7maz."
  fadeDuration: 1
  playOnStart: 1
  introRoot: {fileID: 837454566}
  audioToFadeOut:
  - {fileID: 1519568865}
  - {fileID: 789518741}
